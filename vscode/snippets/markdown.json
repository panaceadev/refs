{
  // Place your snippets for markdown here. Each snippet is defined under a snippet name and has a prefix, body and
  // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
  // same ids are connected.
  // Example:
  // "Print to console": {
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "Omit from TOC": {
    "prefix": "omit",
    "body": ["<!-- omit in toc -->"],
    "description": "Omit this heading from the table of contents"
  },
  "Table (2 columns)": {
    "prefix": "table",
    "body": ["| ${1:head} | ${2:head} |", "| ---- | ---- |", "| ${3:data} | ${4:data} |"],
    "description": "Insert a 2-column table template"
  },
  "!NOTE block": {
    "prefix": "note",
    "body": ["> [!NOTE] $1", "> $2"],
    "description": "Insert a !NOTE block"
  },
  "!TIP block": {
    "prefix": "tip",
    "body": ["> [!TIP] $1", "> $2"],
    "description": "Insert a !TIP block"
  },
  "!IMPORTANT block": {
    "prefix": "important",
    "body": ["> [!IMPORTANT] $1", "> $2"],
    "description": "Insert a !IMPORTANT block"
  },
  "!WARNING block": {
    "prefix": "warning",
    "body": ["> [!WARNING] $1", "> $2"],
    "description": "Insert a !WARNING block"
  },
  "!CAUTION block": {
    "prefix": "caution",
    "body": ["> [!CAUTION] $1", "> $2"],
    "description": "Insert a !CAUTION block"
  }
}
